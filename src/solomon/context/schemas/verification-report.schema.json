{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octavryn:v06:verification-report",
  "title": "VerificationReport (proposed)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "report_id", "project_id", "task_id", "attempt_id", "contract_id", "contract_digest", "status", "verified_at", "checks"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "report_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "verified_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "status", "verifier_id", "verifier_version", "evidence_ids", "reason"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
          "verifier_id": {"type": "string", "minLength": 1},
          "verifier_version": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"evidence_ids": {"minItems": 1}}}}]
      }
    }
  }
}
