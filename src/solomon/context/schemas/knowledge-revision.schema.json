{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octavryn:v06:knowledge-revision",
  "title": "KnowledgeRevision (proposed internal record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "revision_id", "project_id", "kind", "assertion", "effective_at", "valid_until", "evidence_ids", "predecessor_revision_id", "state"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "entry_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["fact", "decision", "requirement", "constraint", "idea"]},
    "assertion": {"type": "string", "minLength": 1, "maxLength": 16384},
    "effective_at": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
    "valid_until": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "predecessor_revision_id": {"type": ["string", "null"], "minLength": 1},
    "state": {"enum": ["STAGED", "ACCEPTED", "SUPERSEDED", "REVOKED"]}
  }
}
